<Project>
	<PropertyGroup>
		<!-- These properties will control the generated plugin info and Thunderstore manifest. -->
		<Title>Smol Randomizer</Title>
		<AssemblyTitle>Smol Randomizer</AssemblyTitle>
		<Description>Randomizer for Miscellanious Smol Things</Description>
		<PackageId>ashilstraza.randomizer.cute</PackageId>
		<!--
    This is the version of your plugin as it would appear in-game and in a mod installer.
    It should follow the format major.minor.patch (semantic versioning). If you publish your mod
    as a library to NuGet, this version will also be used as the package version.
    -->
		<Version>0.1.0</Version>
		<Authors>Ashilstraza</Authors>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/Ashilstraza/Smol_Randomizer</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Ashilstraza/Smol_Randomizer</PackageProjectUrl>
	</PropertyGroup>
</Project>
